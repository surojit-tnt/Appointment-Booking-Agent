# JSON data directory. Relative paths are resolved from the server folder.
DATA_DIR=./data
APP_TIMEZONE=Asia/Kolkata
AVAILABILITY_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Needed only when running the Pipecat voice server.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional TTS provider: elevenlabs (default) or groq.
VOICE_TTS_PROVIDER=elevenlabs
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
ELEVENLABS_API_KEY=
# This shared library voice requires an ElevenLabs plan that permits API use; the dashboard has a browser speech fallback.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
